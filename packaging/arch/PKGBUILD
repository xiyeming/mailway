# Maintainer: xiyeming <https://github.com/xiyeming>
# Mailway —— 原生 Wayland 邮件客户端（Tauri 2 + Rust）
pkgname=mailway
pkgver=0.0.5
pkgrel=1
pkgdesc="原生 Wayland 邮件客户端（Tauri 2 + Rust）"
arch=('x86_64')
url="https://github.com/xiyeming/mailway"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'openssl' 'sqlite' 'hicolor-icon-theme')
makedepends=('rust' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')
options=(!debug)   # 不产 debug 包

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  # Arch 默认 CFLAGS/LDFLAGS（-fno-plt、-Wl,--as-needed 等）会打断 ring 的
  # 汇编对象链接（undefined ring_core_* 符号）——消毒到保守组合
  export CFLAGS="-O2 -pipe"
  export CXXFLAGS="-O2 -pipe"
  export LDFLAGS="-Wl,-O1,--sort-common,--as-needed,-z,relro"
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/mailway "$pkgdir/usr/bin/mailway"
  install -Dm644 packaging/org.mailway.app.desktop \
    "$pkgdir/usr/share/applications/org.mailway.app.desktop"
  for s in 32 128 256 512; do
    install -Dm644 "src-tauri/icons/${s}x${s}.png" \
      "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/org.mailway.app.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
